<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme with Material Design 3 and premium dark styling -->
    <style name="Theme.FearLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/neon_red</item>
        <item name="colorPrimaryVariant">@color/neon_red_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <!-- Background and panel customizations -->
        <item name="android:windowBackground">@color/bg_cyber_dark</item>
        <item name="android:hardwareAccelerated">true</item>

        <!-- Status Bar & Navigation Style -->
        <item name="android:statusBarColor">@color/bg_cyber_dark</item>
        <item name="android:navigationBarColor">@color/bg_cyber_dark</item>
    </style>

    <!-- Transparent / Immersive Glassmorphism Overlay Style -->
    <style name="Widget.FearLauncher.GlassCard" parent="Widget.Material3.Card.Elevated">
        <item name="cardBackgroundColor">@color/panel_dark_semi</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/border_cyber</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardMotionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/activity_dashboard_scene">

    <!-- Highly Optimized Looping Animated Parallax Dust Particles Surface Background -->
    <com.fearlauncher.ui.ParticleBackgroundView
        android:id="@+id/particleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Glow Overlay Header -->
    <View
        android:id="@+id/headerGradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/neon_red_glow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Brand / Status Container -->
    <LinearLayout
        android:id="@+id/brandContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/glowing_dot"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEARLAUNCHER"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELITE EDITION"
                android:textColor="@color/neon_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Coin Balance Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/coinsCard"
        style="@style/Widget.FearLauncher.GlassCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <!-- Coin vector icon placeholder -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_coin"
                android:tint="@color/gold_coins"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150"
                android:textColor="@color/gold_coins"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main View Switcher Container -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/brandContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <!-- ================= PAGE 1: PLAY VIEW ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewPlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Main Interactive Launcher Control Hub -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FearLauncher.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="READY TO LAUNCH"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:letterSpacing="0.1" />

                    <!-- Version Details -->
                    <TextView
                        android:id="@+id/txtActiveVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minecraft 1.20.4"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="4dp" />

                    <!-- Play Button with Spring Animation Micro-interaction -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="20dp"
                        android:text="PLAY"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/neon_red"
                        app:rippleColor="@color/neon_red_glow"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= PAGE 2: MODS & VERSIONS VIEW ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewMods"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtModsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forge / Fabric / Versions"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:layout_margin="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Mod Management & Version Installer list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVersions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/txtModsHeader"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= PAGE 3: SETTINGS VIEW ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SETTINGS &amp; OPTIMIZATIONS"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Game launch optimizations panel -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.FearLauncher.GlassCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engine Optimizations"
                                android:textColor="@color/neon_red"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/cbMesaBypass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Enable Mesa GLSL driver bypass"
                                android:textColor="@color/text_muted"
                                android:layout_marginTop="8dp" />

                            <CheckBox
                                android:id="@+id/cbMultiThread"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Multi-threaded GPU pipeline"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- JRE settings panel -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.FearLauncher.GlassCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Memory Allocation (MB)"
                                android:textColor="@color/neon_red"
                                android:textStyle="bold" />

                            <SeekBar
                                android:id="@+id/sbRam"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="8192"
                                android:progress="2048"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/txtRamVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Allocated Ram: 2048 MB"
                                android:textColor="@color/text_primary"
                                android:layout_gravity="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- Bottom Navigation Bar with micro-interactions -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/panel_dark"
        app:itemIconTint="@color/neon_red"
        app:itemTextColor="@color/text_muted"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.motion.widget.MotionLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cyber_dark">

    <com.fearlauncher.ui.ParticleBackgroundView
        android:id="@+id/particleBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/titleSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DETAILED LAUNCH OPTIONS"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleSettings"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- JVM Arguments Config Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FearLauncher.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom JVM Arguments"
                        android:textColor="@color/neon_red"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etJvmArgs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:hint="-XX:+UseG1GC -XX:+ParallelRefProcEnabled"
                        android:textColorHint="@color/text_muted"
                        android:background="@android:color/transparent"
                        android:layout_marginTop="12dp"
                        android:lines="3"
                        android:gravity="top" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Authentication Server / Skin fallback options -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FearLauncher.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auth Server &amp; Sync"
                        android:textColor="@color/neon_red"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Server syncs custom skins, capes &amp; auth sessions automatically with FearLauncher backend servers via authlib-injector JNI layer."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnTestAuth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TEST AUTHENTICATION STATUS"
                        android:backgroundTint="@color/neon_red_dark"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

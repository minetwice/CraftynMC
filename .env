# Copy this file to .env and fill in real values before running.

# MongoDB Atlas connection string (free tier)
# Get it from https://cloud.mongodb.com -> Database -> Connect -> Drivers
MONGODB_URI=mongodb://localhost:27017/fearlauncher

# Secret used to sign website JWT sessions (any long random string)
JWT_SECRET=fearlauncher_super_secret_key_12345

# Public base URL where this server will be reachable once deployed
# e.g. https://fearlauncher-skinserver.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Port the server listens on (Render sets this automatically, safe to leave)
PORT=3000

# Name shown in the authlib-injector meta endpoint
SERVER_NAME=FearLauncher Network
